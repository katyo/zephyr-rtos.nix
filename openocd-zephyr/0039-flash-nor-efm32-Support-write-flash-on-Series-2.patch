+	0xc6, 0x69,    /*       ldr	r6, [r0, #EFM32_MSC_STATUS_OFFSET] */
+	0x06, 0x27,    /*       movs	r7, #6 */
+	0x3e, 0x42,    /*       tst	r6, r7 */
+	0x16, 0xd1,    /*       bne.n	4c <error> */
+
+	/* wait_wdataready: */
+	0xc6, 0x69,    /*       ldr	r6, [r0, #EFM32_MSC_STATUS_OFFSET] */
+	0x08, 0x27,    /*       movs	r7, #8 */
+	0x3e, 0x42,    /*       tst	r6, r7 */
+	0xfb, 0xd0,    /*       beq.n	1e <wait_wdataready> */
+	0x2e, 0x68,    /*       ldr	r6, [r5, #0] */
