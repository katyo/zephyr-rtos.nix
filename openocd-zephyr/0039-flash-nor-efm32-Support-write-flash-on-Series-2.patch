+	0x08, 0x26,    /*       movs	r6, #8 */
+	0x06, 0x61,    /*       str	r6, [r0, #EFM32_MSC_WRITECMD_OFFSET] */
+	0x04, 0x35,    /*       adds	r5, #4 */
+	0x04, 0x34,    /*       adds	r4, #4 */
+
+	/* busy: */
+	0xc6, 0x69,    /*       ldr	r6, [r0, #28] */
+	0x01, 0x27,    /*       movs	r7, #1 */
+	0x3e, 0x42,    /*       tst	r6, r7 */
+	0xfb, 0xd1,    /*       bne.n	32 <busy> */
+	0x9d, 0x42,    /*       cmp	r5, r3 */
+	0x01, 0xd3,    /*       bcc.n	42 <no_wrap> */
+	0x15, 0x1c,    /*       adds	r5, r2, #0 */
+	0x08, 0x35,    /*       adds	r5, #8 */
+
+	/* no_wrap: */
+	0x55, 0x60,    /*       str	r5, [r2, #4] */
+	0x01, 0x39,    /*       subs	r1, #1 */
+	0x00, 0x29,    /*       cmp	r1, #0 */
+	0x02, 0xd0,    /*       beq.n	50 <exit> */
+	0xdb, 0xe7,    /*       b.n	4 <wait_fifo> */
+
+	/* error: */
+	0x00, 0x20,    /*       movs	r0, #0 */
+	0x50, 0x60,    /*       str	r0, [r2, #4] */
+
+	/* exit: */
+	0x30, 0x1c,    /*       adds	r0, r6, #0 */
+	0x00, 0xbe,    /*       bkpt	0x0000 */
+};
