From 2ec9b8eac018f4711d4a30b41c526770d08a170c Mon Sep 17 00:00:00 2001
From: Henrik Mau <henrik.mau@analog.com>
Date: Tue, 25 Feb 2025 15:54:44 +0000
Subject: [PATCH 22/46] flash/nor/max32xxx: Fix failing flash step for internal
 flash

When attempting to write to internal flash the flashing step fails with
'Error: timeout waiting for algorithm, a target reset is recommended'.
Updated flashing algorithm for MAX32xxx to fix this.

Change-Id: I51350c1320c9699ddcf6cb28d9299538bece4c4f
Signed-off-by: Henrik Mau <henrik.mau@analog.com>
Reviewed-on: https://review.openocd.org/c/openocd/+/8794
Tested-by: jenkins
Reviewed-by: Antonio Borneo <borneo.antonio@gmail.com>
Reviewed-by: zapb <dev@zapb.de>
---
 contrib/loaders/flash/max32xxx/Makefile       |  25 +-
 contrib/loaders/flash/max32xxx/max32xxx.inc   |   6 -
 contrib/loaders/flash/max32xxx/max32xxx.s     |  59 --
 .../loaders/flash/max32xxx/max32xxx_write.c   | 277 +++++++
 .../flash/max32xxx/max32xxx_write_arm.inc     |  57 ++
 src/flash/nor/max32xxx.c                      | 727 ++++++++++--------
 6 files changed, 757 insertions(+), 394 deletions(-)
 delete mode 100644 contrib/loaders/flash/max32xxx/max32xxx.inc
 delete mode 100644 contrib/loaders/flash/max32xxx/max32xxx.s
 create mode 100644 contrib/loaders/flash/max32xxx/max32xxx_write.c
 create mode 100644 contrib/loaders/flash/max32xxx/max32xxx_write_arm.inc

diff --git a/contrib/loaders/flash/max32xxx/Makefile b/contrib/loaders/flash/max32xxx/Makefile
index 1565c811c..fe7666f84 100644
--- a/contrib/loaders/flash/max32xxx/Makefile
+++ b/contrib/loaders/flash/max32xxx/Makefile
@@ -1,21 +1,30 @@
 # SPDX-License-Identifier: GPL-2.0-or-later
 
+TARGET=max32xxx_write
+ENTRY=algo_write
+
 BIN2C = ../../../../src/helper/bin2char.sh
 
-CROSS_COMPILE ?= arm-none-eabi-
-AS      = $(CROSS_COMPILE)as
-OBJCOPY = $(CROSS_COMPILE)objcopy
+PREFIX=arm-none-eabi
+CFLAGS=-mthumb -mcpu=cortex-m4 -Wa,-mimplicit-it=thumb
+
+all: $(TARGET).inc
 
-all: max32xxx.inc
+%.o: %.c
+	$(PREFIX)-gcc $(CFLAGS) -Os -Wall -c ${<} -o ${@}
 
-%.elf: %.s
-	$(AS) $< -o $@
+%.elf: %.o
+	$(PREFIX)-ld -nostdlib --entry $(ENTRY) ${<} -o ${@}
+	$(PREFIX)-size ${@}
 
 %.bin: %.elf
-	$(OBJCOPY) -Obinary $< $@
+	$(PREFIX)-objcopy -O binary ${<} ${@}
 
 %.inc: %.bin
 	$(BIN2C) < $< > $@
 
+%.dasm: %.o
+	$(PREFIX)-objdump -S ${<} > ${TARGET}.dasm
+
 clean:
-	-rm -f *.elf *.bin *.inc
+	rm -rf $(TARGET).bin $(TARGET).elf $(TARGET).o $(TARGET).dasm $(TARGET).inc
